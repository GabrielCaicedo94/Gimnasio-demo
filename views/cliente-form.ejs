<% const v = (k) => (c && c[k] != null ? c[k] : ''); const bloq = (modo === 'editar' && !esAdmin) ? 'disabled' : ''; %>
<div class="card">
  <div class="card-body">
    <% if (errores.length) { %><div class="alert alert-danger"><ul class="mb-0"><% errores.forEach(e => { %><li><%- e.indexOf('<a ') >= 0 ? e : e.replace(/[&<>]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[ch])) %></li><% }) %></ul></div><% } %>
    <form method="post" action="<%= modo === 'editar' ? '/clientes/' + c.id : '/clientes' %>" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h5 class="mb-3">Datos personales</h5>
      <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Tipo de documento</label>
          <select name="tipo_documento" class="form-select" <%= bloq %>><option value="cedula" <%= v('tipo_documento') !== 'pasaporte' ? 'selected' : '' %>>Cédula</option><option value="pasaporte" <%= v('tipo_documento') === 'pasaporte' ? 'selected' : '' %>>Pasaporte</option></select></div>
        <div class="col-md-3"><label class="form-label">Documento *</label><input name="documento" class="form-control" <%= bloq %> value="<%= v('documento') %>" inputmode="numeric" required></div>
        <div class="col-md-3"><label class="form-label">Nombres *</label><input name="nombres" class="form-control" <%= bloq %> value="<%= v('nombres') %>" required></div>
        <div class="col-md-3"><label class="form-label">Apellidos *</label><input name="apellidos" class="form-control" <%= bloq %> value="<%= v('apellidos') %>" required></div>
        <div class="col-md-3"><label class="form-label">Teléfono / WhatsApp</label><input name="telefono" type="tel" class="form-control" value="<%= v('telefono') %>" placeholder="0991234567"></div>
        <div class="col-md-3"><label class="form-label">Correo</label><input name="email" type="email" class="form-control" value="<%= v('email') %>"></div>
        <div class="col-md-3"><label class="form-label">Fecha de nacimiento</label><input name="fecha_nacimiento" type="date" class="form-control" value="<%= v('fecha_nacimiento') %>"></div>
        <div class="col-md-3"><label class="form-label">Género</label>
          <select name="genero" class="form-select"><option value="">—</option>
            <% ['Masculino', 'Femenino', 'Otro'].forEach(g => { %><option <%= v('genero') === g ? 'selected' : '' %>><%= g %></option><% }) %></select></div>
      </div>
      <h5 class="mt-4 mb-3">Emergencia y salud</h5>
      <div class="row g-3">
        <div class="col-md-4"><label class="form-label">Contacto de emergencia</label><input name="contacto_emergencia" class="form-control" value="<%= v('contacto_emergencia') %>"></div>
        <div class="col-md-4"><label class="form-label">Teléfono de emergencia</label><input name="telefono_emergencia" type="tel" class="form-control" value="<%= v('telefono_emergencia') %>"></div>
        <div class="col-md-12"><label class="form-label">Condiciones médicas / lesiones</label><textarea name="condiciones_medicas" class="form-control" rows="2"><%= v('condiciones_medicas') %></textarea></div>
        <div class="col-md-12"><label class="form-label">Notas internas</label><textarea name="notas" class="form-control" rows="2"><%= v('notas') %></textarea></div>
      </div>
      <% if (bloq) { %><p class="text-muted fs-13 mt-3 mb-0"><i class="ti ti-lock"></i> Documento y nombres solo los corrige el administrador.</p><% } %>
      <p class="text-muted fs-13 mt-3 mb-0">Los datos de salud son sensibles: registra solo lo necesario y con el consentimiento del cliente.</p>
      <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="ti ti-device-floppy me-1"></i> Guardar</button>
        <a class="btn btn-light" href="<%= modo === 'editar' ? '/clientes/' + c.id : '/clientes' %>">Cancelar</a>
      </div>
    </form>
  </div>
</div>
