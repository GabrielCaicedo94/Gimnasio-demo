<div class="row g-3">
  <div class="col-xl-4">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <% if (c.foto) { %><img src="/fotos/<%= c.id %>?v=<%= encodeURIComponent(c.foto) %>" alt="Foto" class="rounded-circle foto-perfil" data-ampliar title="Clic para ampliar" style="width:128px;height:128px;object-fit:cover;cursor:zoom-in">
          <% } else { %><span class="rounded-circle bg-body-secondary d-flex align-items-center justify-content-center text-muted" style="width:128px;height:128px"><i class="ti ti-user" style="font-size:56px"></i></span><% } %>
          <div class="d-flex flex-column gap-1">
            <form action="/clientes/<%= c.id %>/foto?_csrf=<%= csrf %>" method="post" enctype="multipart/form-data" class="m-0">
              <label class="btn btn-sm btn-outline-primary mb-0 w-100"><i class="ti ti-camera"></i> <%= c.foto ? 'Tomar otra foto' : 'Tomar foto' %>
                <input type="file" name="foto" accept="image/*" capture="user" data-camara data-reducir="800" data-enviar hidden></label>
            </form>
            <form action="/clientes/<%= c.id %>/foto?_csrf=<%= csrf %>" method="post" enctype="multipart/form-data" class="m-0">
              <label class="btn btn-sm btn-outline-secondary mb-0 w-100"><i class="ti ti-folder"></i> Elegir foto
                <input type="file" name="foto" accept="image/*" data-reducir="800" data-enviar hidden></label>
            </form>
            <% if (c.foto) { %>
            <form action="/clientes/<%= c.id %>/foto/eliminar" method="post" class="m-0" data-confirmar="¿Eliminar la foto de este cliente?" data-tipo="peligro" data-boton="Eliminar foto">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-sm btn-outline-danger w-100"><i class="ti ti-trash"></i> Eliminar foto</button>
            </form>
            <% } %>
          </div>
        </div>
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h4 class="mb-1"><%= c.nombres %> <%= c.apellidos %></h4>
            <% if (!(est.k === 'sin' && ultimoPase)) { %><span class="badge bg-<%= est.color %>-subtle text-<%= est.color %> fs-13"><%= est.texto %></span><% } %>
            <% if (actual) { %><div class="text-muted mt-2 fs-13">Vence: <b><%= U.verFecha(actual.fecha_fin) %></b></div><% } %>
            <% if (!actual && ultimoPase) { %><div class="mt-2"><span class="badge bg-info-subtle text-info fs-13">Pase diario</span> <span class="text-muted fs-13">última visita: <%= U.verFecha(ultimoPase) %></span></div><% } %>
          </div>
          <a href="/clientes/<%= c.id %>/editar" class="btn btn-sm btn-soft-secondary"><i class="ti ti-edit"></i> Editar</a>
        </div>
        <hr>
        <dl class="row mb-0 fs-14">
          <dt class="col-5 text-muted fw-normal"><%= c.tipo_documento === 'pasaporte' ? 'Pasaporte' : 'Cédula' %></dt><dd class="col-7"><%= c.documento %></dd>
          <dt class="col-5 text-muted fw-normal">Teléfono</dt>
          <dd class="col-7"><%= c.telefono || '—' %>
            <% if (wa) { %><a href="https://wa.me/<%= wa %>" target="_blank" rel="noopener" class="ms-1 text-success" title="Abrir WhatsApp"><i class="ti ti-brand-whatsapp fs-18"></i></a><% } %></dd>
          <dt class="col-5 text-muted fw-normal">Correo</dt><dd class="col-7 text-break"><%= c.email || '—' %></dd>
          <dt class="col-5 text-muted fw-normal">Nacimiento</dt><dd class="col-7"><%= U.verFecha(c.fecha_nacimiento) %></dd>
          <dt class="col-5 text-muted fw-normal">Género</dt><dd class="col-7"><%= c.genero || '—' %></dd>
          <dt class="col-5 text-muted fw-normal">Registro</dt><dd class="col-7"><%= U.verFecha(c.fecha_registro) %></dd>
          <dt class="col-5 text-muted fw-normal">Emergencia</dt><dd class="col-7"><%= c.contacto_emergencia || '—' %> <%= c.telefono_emergencia || '' %></dd>
          <dt class="col-5 text-muted fw-normal">Salud</dt><dd class="col-7"><%= c.condiciones_medicas || '—' %></dd>
          <dt class="col-5 text-muted fw-normal">Notas</dt><dd class="col-7"><%= c.notas || '—' %></dd>
        </dl>
        <% if (esAdmin) { %>
        <hr>
        <div class="d-flex gap-2 flex-wrap">
        <form action="/clientes/<%= c.id %>/desactivar" method="post" data-confirmar="¿Desactivar este cliente? Su historial se conserva." data-tipo="peligro" data-boton="Desactivar">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-sm btn-outline-danger" type="submit">Desactivar cliente</button>
        </form>
        <% if (puedeEliminar) { %>
        <form action="/clientes/<%= c.id %>/eliminar" method="post" data-confirmar="¿Eliminar definitivamente este cliente (duplicado)? No tiene pagos. No se puede deshacer." data-tipo="peligro" data-boton="Eliminar definitivamente">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-sm btn-danger" type="submit">Eliminar (duplicado)</button>
        </form>
        <% } %>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-xl-8">
    <!-- Registrar pago -->
    <div class="card border-primary" id="renovar">
      <div class="card-header"><h5 class="card-title mb-0"><i class="ti ti-cash me-1"></i> Registrar pago / renovar membresía</h5></div>
      <div class="card-body">
        <form action="/clientes/<%= c.id %>/renovar?_csrf=<%= csrf %>" method="post" enctype="multipart/form-data">
          <div class="row g-3">
            <div class="col-md-4"><label class="form-label">Plan *</label>
              <select name="plan_id" id="plan_id" class="form-select" required>
                <% planes.forEach(p => { %><option value="<%= p.id %>" data-precio="<%= U.dineroInput(p.precio_centavos) %>" data-dias="<%= p.duracion_dias %>" <%= p.nombre === 'Mensual' ? 'selected' : '' %>><%= p.nombre %> (<%= U.plural(p.duracion_dias) %>) — <%= U.dinero(p.precio_centavos) %></option><% }) %>
              </select></div>
            <div class="col-md-4"><label class="form-label">Inicio *</label>
              <% const hintInicio = inicioSugerido > hoy ? 'Sigue al vencimiento actual para no perder días.' : 'Hoy.'; %>
              <input type="date" name="fecha_inicio" id="fecha_inicio" class="form-control" value="<%= inicioSugerido %>" data-sugerido="<%= inicioSugerido %>" data-hoy="<%= hoy %>" data-hint="<%= hintInicio %>" required>
              <div class="form-text" id="hint-inicio"><%= hintInicio %></div></div>
            <div class="col-md-4"><label class="form-label">Monto cobrado ($) *</label>
              <input name="monto" id="monto" class="form-control" inputmode="decimal" required></div>
            <div class="col-md-4"><label class="form-label">Método *</label>
              <select name="metodo" id="metodo" class="form-select">
                <option value="efectivo">Efectivo</option><option value="transferencia">Transferencia</option><option value="datafast">Datafast / tarjeta</option><option value="otro">Otro</option>
              </select></div>
            <div class="col-md-8 d-none" id="bloque-ref"><label class="form-label">N.º de comprobante / referencia</label>
              <input name="referencia" class="form-control" maxlength="60" placeholder="Opcional"></div>

            <div class="col-12 d-none" id="bloque-comprobante">
              <label class="form-label">Comprobante de pago * <span class="text-muted fw-normal">(captura de la transferencia o foto del voucher)</span></label>
              <div class="row g-2">
                <div class="col-sm-6">
                  <label class="btn btn-primary btn-foto w-100 d-flex align-items-center justify-content-center mb-0">
                    <i class="ti ti-camera me-2 fs-20"></i> Tomar foto
                    <input type="file" name="foto" accept="image/*" capture="environment" data-camara data-preview="vista" data-reducir="1600" hidden>
                  </label></div>
                <div class="col-sm-6">
                  <label class="btn btn-outline-primary btn-foto w-100 d-flex align-items-center justify-content-center mb-0">
                    <i class="ti ti-folder me-2 fs-20"></i> Elegir imagen o PDF
                    <input type="file" name="archivo" accept="image/*,application/pdf" data-preview="vista" data-reducir="1600" hidden>
                  </label></div>
              </div>
              <div id="vista"></div>
            </div>
            <div class="col-12"><label class="form-label">Notas</label><input name="notas" class="form-control" maxlength="300" placeholder="Opcional (ej. descuento, abono…)"></div>
          </div>
          <div class="mt-3"><button class="btn btn-success btn-lg" type="submit"><i class="ti ti-check me-1"></i> Guardar pago</button></div>
        </form>
      </div>
    </div>

    <!-- Historial -->
    <div class="card">
      <div class="card-header"><h5 class="card-title mb-0">Historial de pagos y membresías</h5></div>
      <div class="table-responsive">
        <table class="table mb-0">
          <thead class="table-light"><tr><th>Fecha pago</th><th>Plan</th><th>Periodo</th><th>Monto</th><th>Método</th><th>Comprobante</th><th></th></tr></thead>
          <tbody>
            <% if (!pagos.length) { %><tr><td colspan="7" class="text-center text-muted py-4">Sin pagos registrados.</td></tr><% } %>
            <% pagos.forEach(p => { %>
              <tr class="<%= p.estado === 'anulado' ? 'text-muted' : '' %>">
                <td><%= U.verFecha(p.fecha_pago) %><% if (p.estado === 'anulado') { %> <span class="badge bg-danger">ANULADO</span><% } %><div class="text-muted fs-12"><%= p.registrado_por || '' %></div></td>
                <td><%= p.plan %></td>
                <td class="fs-13"><%= U.verFecha(p.fecha_inicio) %> → <%= U.verFecha(p.fecha_fin) %></td>
                <td class="fw-semibold <%= p.estado === 'anulado' ? 'text-decoration-line-through' : '' %>"><%= U.dinero(p.monto_centavos) %></td>
                <td><%= p.metodo %><% if (p.referencia) { %><div class="text-muted fs-12">Ref. <%= p.referencia %></div><% } %></td>
                <td><%- include('partials/comp-celda', { p }) %></td>
                <td><a class="btn btn-sm btn-soft-secondary" href="/pagos/<%= p.id %>">Ver</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
