<div class="row"><div class="col-lg-6">
  <div class="card"><div class="card-header"><h5 class="card-title mb-0"><i class="ti ti-key me-1"></i> Cambiar mi contraseña</h5></div>
    <div class="card-body">
      <% if (obligatorio) { %><div class="alert alert-warning">Tienes una clave temporal. Debes cambiarla para continuar.</div><% } %>
      <p class="text-muted mb-3">Usuario: <b><%= user.usuario %></b> · Rol: <b><%= esAdmin ? 'Administrador' : 'Recepción' %></b></p>
      <form action="/cuenta/clave" method="post" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="mb-2"><input type="password" name="actual" class="form-control" placeholder="Contraseña actual" autocomplete="current-password" required></div>
        <div class="mb-2"><input type="password" name="nueva" class="form-control" placeholder="Nueva contraseña (mín. 8)" autocomplete="new-password" required></div>
        <div class="mb-3"><input type="password" name="nueva2" class="form-control" placeholder="Repite la nueva" autocomplete="new-password" required></div>
        <button class="btn btn-primary">Cambiar contraseña</button>
      </form>
    </div></div>
</div></div>
