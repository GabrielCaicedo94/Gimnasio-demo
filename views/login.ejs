<div class="auth-bg d-flex min-vh-100">
  <div class="row g-0 justify-content-center w-100 m-3">
    <div class="col-xxl-3 col-lg-5 col-md-6 align-self-center">
      <a class="auth-brand d-flex justify-content-center mb-3"><img src="/images/logo-hd.png" alt="Gym Demo" height="64" style="background:#000;padding:10px 18px;border-radius:10px"></a>
      <p class="fw-semibold mb-4 text-center text-muted fs-15"><%= cfg.nombre_gimnasio %></p>
      <div class="card p-3 p-xxl-4">
        <h4 class="fw-semibold mb-3 fs-18 text-center">Iniciar sesión</h4>
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <form method="post" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="mb-3"><label class="form-label">Usuario</label>
            <input name="usuario" class="form-control" autocomplete="username" autofocus required></div>
          <div class="mb-3"><label class="form-label">Contraseña</label>
            <input type="password" name="clave" class="form-control" autocomplete="current-password" required></div>
          <div class="d-grid"><button class="btn btn-primary fw-semibold" type="submit">Entrar</button></div>
        </form>
      </div>
    </div>
  </div>
</div>
