<div class="row g-3">
  <div class="col-lg-8">
    <div class="card"><div class="table-responsive"><table class="table mb-0 align-middle">
      <thead class="table-light"><tr><th>Usuario</th><th>Rol</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
      <tbody>
      <% usuarios.forEach(u => { %>
        <tr class="<%= u.activo ? '' : 'text-muted' %>">
          <td><b><%= u.nombre %></b><div class="text-muted fs-13"><%= u.usuario %><% if (u.cambiar_clave) { %> · <span class="text-warning">clave temporal pendiente de cambiar</span><% } %></div></td>
          <td><span class="badge bg-<%= u.rol === 'admin' ? 'primary' : 'secondary' %>-subtle text-<%= u.rol === 'admin' ? 'primary' : 'secondary' %>"><%= u.rol === 'admin' ? 'Administrador' : 'Recepción' %></span></td>
          <td><span class="badge bg-<%= u.activo ? 'success' : 'danger' %>-subtle text-<%= u.activo ? 'success' : 'danger' %>"><%= u.activo ? 'Activo' : 'Desactivado' %></span></td>
          <td class="text-end">
            <% if (u.rol === 'recepcion') { %>
              <form action="/usuarios/<%= u.id %>/clave" method="post" class="d-inline-flex gap-1 mb-1">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <input type="text" name="clave" class="form-control form-control-sm" style="width:150px" placeholder="Nueva clave temporal" minlength="8" required autocomplete="off">
                <button class="btn btn-sm btn-outline-primary" title="Asignar clave temporal">Restablecer</button>
              </form>
              <form action="/usuarios/<%= u.id %>/activo" method="post" class="d-inline" data-confirmar="<%= u.activo ? '¿Desactivar a ' + u.nombre + '? No podrá entrar al sistema.' : '¿Activar a ' + u.nombre + '?' %>" data-tipo="<%= u.activo ? 'peligro' : 'aviso' %>" data-boton="<%= u.activo ? 'Desactivar' : 'Activar' %>">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn btn-sm btn-outline-<%= u.activo ? 'danger' : 'success' %>"><%= u.activo ? 'Desactivar' : 'Activar' %></button>
              </form>
            <% } else { %><span class="text-muted fs-13">Lo gestiona soporte técnico</span><% } %>
          </td>
        </tr>
      <% }) %>
      </tbody></table></div></div>
  </div>
  <div class="col-lg-4">
    <div class="card"><div class="card-header"><h5 class="card-title mb-0">Nuevo recepcionista</h5></div><div class="card-body">
      <form action="/usuarios" method="post" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="mb-2"><label class="form-label">Nombre completo</label><input name="nombre" class="form-control" value="<%= v.nombre || '' %>" required></div>
        <div class="mb-2"><label class="form-label">Usuario</label><input name="usuario" class="form-control" value="<%= v.usuario || '' %>" required></div>
        <div class="mb-3"><label class="form-label">Clave temporal (mín. 8)</label><input name="clave" type="text" class="form-control" minlength="8" required autocomplete="off"></div>
        <button class="btn btn-primary">Crear recepcionista</button>
      </form>
      <p class="text-muted fs-13 mt-3 mb-0">Deberá cambiar la clave al entrar por primera vez. Un recepcionista desactivado conserva su historial, pero no puede ingresar. Los administradores los crea soporte técnico.</p>
    </div></div>
  </div>
</div>
